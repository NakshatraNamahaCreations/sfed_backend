# Copy to .env and fill in. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sfed
JWT_SECRET=long-random-string
CLIENT_URL=https://your-admin-site.netlify.app
STORE_URL=https://your-website.netlify.app
# shared with the website's REVALIDATE_SECRET (instant updates after admin edits)
REVALIDATE_SECRET=long-random-string
# optional: public address of this API (used for uploaded file links)
PUBLIC_URL=
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# leave as "placeholder" to store uploads on disk instead of Cloudinary
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
